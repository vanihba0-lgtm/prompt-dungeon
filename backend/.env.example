# Prompt Dungeon Backend Environment Configuration Example
# Copy this file to backend/.env for local overrides. Do NOT commit .env.

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Allowed Origins (Comma-separated list or JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Dialogue Model Settings (Backend Only - NEVER expose to client)
# Options for LLM_PROVIDER: "groq", "openrouter", "together", or "none" (deterministic fallback)
LLM_PROVIDER=none
LLM_API_KEY=

# Supported Gemma model IDs:
#   Groq:        gemma2-9b-it
#   OpenRouter:  google/gemma-3-12b-it (or google/gemma-2-27b-it)
#   Together:    google/gemma-2-27b-it
LLM_MODEL_ID=

# Optional API Base URL override (auto-detected if blank):
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together:    https://api.together.xyz/v1
LLM_API_BASE_URL=
LLM_TIMEOUT_SECONDS=10.0

# Rate Limiting
RATE_LIMIT_INTERROGATIONS_PER_MINUTE=30
